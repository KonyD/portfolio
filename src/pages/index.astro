---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "Home Page";
---

<BaseLayout title={pageTitle}>
    <div class="max-w-4xl">
        <h1 class="font-extrabold text-4xl text-slate-800 drop-shadow-sm mb-4">
            Hi, I'm Asil Poyraz Şahin
        </h1>

        <div class="text-lg text-slate-700 leading-relaxed space-y-4">
            <p>
                I'm a 19 year old Computer Engineering student at Istanbul
                Kültür University. Currently, I'm working on projects in Full
                Stack Development, Game Development, and Deep Learning.
            </p>
            <p>
                For my own game projects, I prefer the <strong
                    >Godot Game Engine</strong
                >. My technical interests range from crafting backend APIs in <strong
                    >Go and Node.js</strong
                >, to exploring low-level systems by building hardware
                emulators, and training machine learning models.
            </p>
        </div>
    </div>

    <div class="mt-12">
        <h2 class="font-extrabold text-3xl text-slate-800 drop-shadow-sm mb-6">
            My GitHub Contribution Graph
        </h2>
        <div
            class="flex items-center justify-center p-6 bg-gradient-to-b from-white/80 to-white/30 rounded-3xl border-2 border-white/90 shadow-[0_4px_10px_rgba(0,0,0,0.03),inset_0_2px_5px_rgba(255,255,255,1)] overflow-hidden"
        >
            <div class="w-full overflow-x-auto pb-2">
                <img
                    src="https://ghchart.rshah.org/ff8b1f/KonyD"
                    alt="GitHub Contributions Graph"
                    class="w-full min-w-[750px] object-contain"
                />
            </div>
        </div>
    </div>

    <div class="mt-12">
        <h2
            class="font-extrabold text-3xl text-slate-800 drop-shadow-sm mb-6 items-center gap-3"
        >
            Tech Stack
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6">
            <!-- Go Tile -->
            <div
                class="group flex items-center justify-center p-6 bg-gradient-to-b from-white/80 to-white/30 rounded-3xl border-2 border-white/90 shadow-[0_4px_10px_rgba(0,0,0,0.03),inset_0_2px_5px_rgba(255,255,255,1)] hover:shadow-[0_10px_25px_rgba(0,0,0,0.1)] hover:-translate-y-2 transition-all duration-300"
            >
                <img
                    class="h-16 w-16 object-contain group-hover:scale-110 group-hover:drop-shadow-md transition-all duration-300"
                    src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/go/go-original-wordmark.svg"
                    alt="Go"
                />
            </div>

            <!-- Node.js Tile -->
            <div
                class="group flex items-center justify-center p-6 bg-gradient-to-b from-white/80 to-white/30 rounded-3xl border-2 border-white/90 shadow-[0_4px_10px_rgba(0,0,0,0.03),inset_0_2px_5px_rgba(255,255,255,1)] hover:shadow-[0_10px_25px_rgba(0,0,0,0.1)] hover:-translate-y-2 transition-all duration-300"
            >
                <img
                    class="h-16 w-16 object-contain group-hover:scale-110 group-hover:drop-shadow-md transition-all duration-300"
                    src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nodejs/nodejs-original-wordmark.svg"
                    alt="Node.js"
                />
            </div>

            <!-- Godot Tile (Added for Game Dev) -->
            <div
                class="group flex items-center justify-center p-6 bg-gradient-to-b from-white/80 to-white/30 rounded-3xl border-2 border-white/90 shadow-[0_4px_10px_rgba(0,0,0,0.03),inset_0_2px_5px_rgba(255,255,255,1)] hover:shadow-[0_10px_25px_rgba(0,0,0,0.1)] hover:-translate-y-2 transition-all duration-300"
            >
                <img
                    class="h-16 w-16 object-contain group-hover:scale-110 group-hover:drop-shadow-md transition-all duration-300"
                    src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/godot/godot-original-wordmark.svg"
                    alt="Godot"
                />
            </div>

            <!-- Javascript Tile -->
            <div
                class="group flex items-center justify-center p-6 bg-gradient-to-b from-white/80 to-white/30 rounded-3xl border-2 border-white/90 shadow-[0_4px_10px_rgba(0,0,0,0.03),inset_0_2px_5px_rgba(255,255,255,1)] hover:shadow-[0_10px_25px_rgba(0,0,0,0.1)] hover:-translate-y-2 transition-all duration-300"
            >
                <img
                    class="h-16 w-16 object-contain group-hover:scale-110 group-hover:drop-shadow-md transition-all duration-300"
                    src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/javascript/javascript-original.svg"
                    alt="Javascript"
                />
            </div>

            <!-- TypeScript Tile -->
            <div
                class="group flex items-center justify-center p-6 bg-gradient-to-b from-white/80 to-white/30 rounded-3xl border-2 border-white/90 shadow-[0_4px_10px_rgba(0,0,0,0.03),inset_0_2px_5px_rgba(255,255,255,1)] hover:shadow-[0_10px_25px_rgba(0,0,0,0.1)] hover:-translate-y-2 transition-all duration-300"
            >
                <img
                    class="h-16 w-16 object-contain group-hover:scale-110 group-hover:drop-shadow-md transition-all duration-300"
                    src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/typescript/typescript-original.svg"
                    alt="TypeScript"
                />
            </div>

            <!-- HTML5 Tile -->
            <div
                class="group flex items-center justify-center p-6 bg-gradient-to-b from-white/80 to-white/30 rounded-3xl border-2 border-white/90 shadow-[0_4px_10px_rgba(0,0,0,0.03),inset_0_2px_5px_rgba(255,255,255,1)] hover:shadow-[0_10px_25px_rgba(0,0,0,0.1)] hover:-translate-y-2 transition-all duration-300"
            >
                <img
                    class="h-16 w-16 object-contain group-hover:scale-110 group-hover:drop-shadow-md transition-all duration-300"
                    src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/html5/html5-original-wordmark.svg"
                    alt="HTML5"
                />
            </div>

            <!-- CSS3 Tile -->
            <div
                class="group flex items-center justify-center p-6 bg-gradient-to-b from-white/80 to-white/30 rounded-3xl border-2 border-white/90 shadow-[0_4px_10px_rgba(0,0,0,0.03),inset_0_2px_5px_rgba(255,255,255,1)] hover:shadow-[0_10px_25px_rgba(0,0,0,0.1)] hover:-translate-y-2 transition-all duration-300"
            >
                <img
                    class="h-16 w-16 object-contain group-hover:scale-110 group-hover:drop-shadow-md transition-all duration-300"
                    src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/css3/css3-original-wordmark.svg"
                    alt="CSS3"
                />
            </div>

            <!-- MongoDB Tile -->
            <div
                class="group flex items-center justify-center p-6 bg-gradient-to-b from-white/80 to-white/30 rounded-3xl border-2 border-white/90 shadow-[0_4px_10px_rgba(0,0,0,0.03),inset_0_2px_5px_rgba(255,255,255,1)] hover:shadow-[0_10px_25px_rgba(0,0,0,0.1)] hover:-translate-y-2 transition-all duration-300"
            >
                <img
                    class="h-16 w-16 object-contain group-hover:scale-110 group-hover:drop-shadow-md transition-all duration-300"
                    src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/mongodb/mongodb-original-wordmark.svg"
                    alt="MongoDB"
                />
            </div>

            <!-- Next.js Tile -->
            <div
                class="group flex items-center justify-center p-6 bg-gradient-to-b from-white/80 to-white/30 rounded-3xl border-2 border-white/90 shadow-[0_4px_10px_rgba(0,0,0,0.03),inset_0_2px_5px_rgba(255,255,255,1)] hover:shadow-[0_10px_25px_rgba(0,0,0,0.1)] hover:-translate-y-2 transition-all duration-300"
            >
                <img
                    class="h-16 w-16 object-contain group-hover:scale-110 group-hover:drop-shadow-md transition-all duration-300"
                    src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nextjs/nextjs-original.svg"
                    alt="Next.js"
                />
            </div>

            <!-- React Tile -->
            <div
                class="group flex items-center justify-center p-6 bg-gradient-to-b from-white/80 to-white/30 rounded-3xl border-2 border-white/90 shadow-[0_4px_10px_rgba(0,0,0,0.03),inset_0_2px_5px_rgba(255,255,255,1)] hover:shadow-[0_10px_25px_rgba(0,0,0,0.1)] hover:-translate-y-2 transition-all duration-300"
            >
                <img
                    class="h-16 w-16 object-contain group-hover:scale-110 group-hover:drop-shadow-md transition-all duration-300"
                    src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/react/react-original.svg"
                    alt="React"
                />
            </div>

            <!-- Tailwind Tile -->
            <div
                class="group flex items-center justify-center p-6 bg-gradient-to-b from-white/80 to-white/30 rounded-3xl border-2 border-white/90 shadow-[0_4px_10px_rgba(0,0,0,0.03),inset_0_2px_5px_rgba(255,255,255,1)] hover:shadow-[0_10px_25px_rgba(0,0,0,0.1)] hover:-translate-y-2 transition-all duration-300"
            >
                <img
                    class="h-16 w-16 object-contain group-hover:scale-110 group-hover:drop-shadow-md transition-all duration-300"
                    src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/tailwindcss/tailwindcss-original.svg"
                    alt="Tailwind"
                />
            </div>

            <!-- Python Tile -->
            <div
                class="group flex items-center justify-center p-6 bg-gradient-to-b from-white/80 to-white/30 rounded-3xl border-2 border-white/90 shadow-[0_4px_10px_rgba(0,0,0,0.03),inset_0_2px_5px_rgba(255,255,255,1)] hover:shadow-[0_10px_25px_rgba(0,0,0,0.1)] hover:-translate-y-2 transition-all duration-300"
            >
                <img
                    class="h-16 w-16 object-contain group-hover:scale-110 group-hover:drop-shadow-md transition-all duration-300"
                    src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg"
                    alt="Python"
                />
            </div>

            <!-- Git Tile -->
            <div
                class="group flex items-center justify-center p-6 bg-gradient-to-b from-white/80 to-white/30 rounded-3xl border-2 border-white/90 shadow-[0_4px_10px_rgba(0,0,0,0.03),inset_0_2px_5px_rgba(255,255,255,1)] hover:shadow-[0_10px_25px_rgba(0,0,0,0.1)] hover:-translate-y-2 transition-all duration-300"
            >
                <img
                    class="h-16 w-16 object-contain group-hover:scale-110 group-hover:drop-shadow-md transition-all duration-300"
                    src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/git/git-original.svg"
                    alt="Git"
                />
            </div>
        </div>
    </div>
</BaseLayout>
