---
import "github-markdown-css/github-markdown-light.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { marked } from "marked";

export async function getStaticPaths() {
    return [
        { params: { repoName: "subscription-tracker" } },
        { params: { repoName: "action-rpg-template" } },
        { params: { repoName: "chip8-emulator" } },
        { params: { repoName: "skribble-clone" } },
        { params: { repoName: "react-todo-app" } },
        { params: { repoName: "tusimple-lane-detection" } },
    ];
}

const { repoName } = Astro.params;
const repoPath = `KonyD/${repoName}`;

const apiResponse = await fetch(`https://api.github.com/repos/${repoPath}`);
const repoData = await apiResponse.json();

const { name, description, stargazers_count, forks_count, html_url, topics } =
    repoData;

const readmeUrl = `https://raw.githubusercontent.com/${repoPath}/main/README.md`;
const readmeResponse = await fetch(readmeUrl);
const markdown = await readmeResponse.text();
const htmlContent = marked.parse(markdown);
---

<BaseLayout title={`${name} | KonyDev`}>
    <div class="mt-8 mb-8 p-8 relative overflow-hidden">
        <h1
            class="text-4xl font-extrabold text-slate-800 drop-shadow-sm mb-3 relative z-10 capitalize"
        >
            {name.replace(/-/g, " ")}
        </h1>

        <p
            class="text-lg text-slate-600 font-medium mb-6 relative z-10 max-w-2xl"
        >
            {description}
        </p>

        <div class="flex flex-wrap items-center gap-3 relative z-10">
            <div
                class="flex items-center gap-1.5 px-3 py-1 bg-gradient-to-b from-amber-100 to-orange-100 text-orange-800 text-sm font-bold rounded-full border border-white shadow-[inset_0_1px_2px_rgba(255,255,255,1),0_2px_4px_rgba(0,0,0,0.05)]"
            >
                {stargazers_count} Stars
            </div>

            <div
                class="flex items-center gap-1.5 px-3 py-1 bg-gradient-to-b from-blue-100 to-sky-100 text-sky-800 text-sm font-bold rounded-full border border-white shadow-[inset_0_1px_2px_rgba(255,255,255,1),0_2px_4px_rgba(0,0,0,0.05)]"
            >
                {forks_count} Forks
            </div>

            <div class="w-px h-6 bg-slate-300 mx-2"></div>

            <!-- Render Topics -->
            {
                topics && topics.length > 0 && (
                    <div>
                        {topics.map((topic) => (
                            <span class="mr-3 px-3 py-1 bg-white/60 text-slate-700 text-sm font-bold rounded-full border border-white shadow-[inset_0_1px_2px_rgba(255,255,255,1),0_2px_4px_rgba(0,0,0,0.05)]">
                                {topic}
                            </span>
                        ))}
                    </div>
                )
            }
        </div>
    </div>

    <!-- Rendered README Content -->
    <div class="bg-white p-8 rounded-3xl shadow-sm">
        <article class="markdown-body">
            <Fragment set:html={htmlContent} />
        </article>
    </div>

    <div class="mt-8 mb-12 flex justify-center">
        <a
            href={html_url}
            target="_blank"
            class="px-8 py-3 rounded-full font-bold text-white bg-gradient-to-b from-amber-400 to-amber-600 shadow-[inset_0_1px_2px_rgba(255,255,255,0.6),0_4px_10px_rgba(0,0,0,0.1)] hover:-translate-y-1 hover:shadow-[0_6px_15px_rgba(0,0,0,0.15)] transition-all flex items-center gap-2"
        >
            View Source on GitHub &rarr;
        </a>
    </div>
</BaseLayout>
