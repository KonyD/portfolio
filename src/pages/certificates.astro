---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "Certificates";

const certificates = [
    {
        name: "Automotive Summer Camp 2026",
        issuer: "Automotive Manufacturers Association",
        date: "July 2026",
        description:
            "Completed an intensive 4-day engineering educational program focusing on modern automotive technologies, manufacturing processes, and industry practices.",
        color: "from-blue-400 to-sky-300",
        image: "/portfolio/certificates/otomotiv-yaz-kampi-basari-sertifikasi.jpg",
    },
    {
        name: "Deep Learning Algorithms with Keras",
        issuer: "BTK Akademi",
        date: "January 2025",
        description:
            "Covered deep learning architectures from ANNs, CNNs, and LSTMs to advanced GANs, Reinforcement Learning, and Transformers. Focused on end-to-end model training, evaluation, and solving real-world problems using Keras.",
        color: "from-blue-400 to-sky-300",
        image: "/portfolio/certificates/keras-ile-derin-ogrenme-algoritmalari.png",
    },
    {
        name: "C Programming Language",
        issuer: "BTK Akademi",
        date: "May 2025",
        description:
            "Intensive training covering core syntax and practical applications in both low-level and high-level programming. Provides a solid foundation for systems-level development and hardware architecture.",
        color: "from-blue-400 to-sky-300",
        image: "/portfolio/certificates/c-programlama-dili.png",
    },
];
---

<BaseLayout pageTitle={pageTitle}>
    <div class="mt-8 mb-12">
        <h1
            class="text-4xl font-extrabold text-slate-800 drop-shadow-sm mb-4 flex items-center gap-3"
        >
            Certificates
        </h1>
        <p class="text-lg text-slate-600 font-medium max-w-2xl">
            A collection of my educational programs, hackathons, and
            professional certifications.
        </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        {
            certificates.map((cert) => (
                <div class="group relative overflow-hidden bg-white/40 p-8 rounded-3xl border border-white/80 shadow-[0_4px_15px_rgba(0,0,0,0.05)] backdrop-blur-md hover:-translate-y-2 hover:shadow-[0_10px_25px_rgba(0,0,0,0.1)] transition-all duration-300">
                    <div class="absolute -top-12 -right-12 w-40 h-40 bg-gradient-to-br from-white/90 to-transparent rounded-full blur-2xl pointer-events-none group-hover:scale-125 transition-transform duration-500" />

                    <div class="relative w-full h-48 mb-6 rounded-2xl overflow-hidden border-2 border-white/90 shadow-[0_4px_10px_rgba(0,0,0,0.1)] z-10 shrink-0">
                        <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/40 to-transparent pointer-events-none z-20" />

                        <img
                            src={cert.image}
                            alt={cert.name}
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        />
                    </div>

                    <div class="relative z-10">
                        <h2 class="text-2xl font-bold text-slate-800 drop-shadow-sm mb-1 group-hover:text-amber-600 transition-colors">
                            {cert.name}
                        </h2>
                        <h3 class="text-md font-bold text-slate-500 mb-4 flex items-center gap-1.5">
                            {cert.issuer} - {cert.date}
                        </h3>

                        <div class="w-12 h-1 bg-gradient-to-r from-amber-400 to-orange-400 rounded-full mb-4 shadow-sm" />

                        <p class="text-slate-600 font-medium leading-relaxed">
                            {cert.description}
                        </p>
                    </div>
                </div>
            ))
        }
    </div>
</BaseLayout>
