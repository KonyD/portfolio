---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, "");
const navBase =
    "relative px-4 py-3 text-sm font-bold transition-all duration-200 flex items-center gap-1";
const navActive =
    "text-orange-600 border-b-2 border-orange-500 bg-orange-50/50";
const navInactive =
    "text-slate-600 hover:text-orange-500 hover:bg-orange-50/50 border-b-2 border-transparent";
---

<header
    class="relative w-full border-b bg-gradient-to-b from-amber-400 via-amber-500 to-amber-600 shadow-xl"
>
    <div
        class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between relative z-10"
    >
        <a href="/portfolio/" class="flex items-center gap-2 group">
            <img
                class="rounded-full w-16 h-16"
                src="https://konyd.github.io/portfolio/avatar.png"
            />
            <span
                class="text-2xl font-bold tracking-tight text-amber-50 drop-shadow-[0_2px_2px_rgba(0,0,0,0.5)] group-hover:text-amber-100 transition-colors"
            >
                Asil Poyraz Şahin
            </span>
        </a>

        <div class="flex items-center gap-3 ml-4 pl-4 border-l border-white/30">
            <a href="https://github.com/KonyD" class="w-8 h-8">
                <img
                    src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/github/github-original.svg"
                    alt="GitHub"
                />
            </a>

            <a
                href="https://www.linkedin.com/in/asil-poyraz-%C5%9Fahin-71456b332/"
                class="w-8 h-8"
            >
                <img
                    src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/linkedin/linkedin-original.svg"
                    alt="LinkedIn"
                />
            </a>
        </div>
    </div>

    <div
        class="w-full bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm relative z-20"
    >
        <nav class="max-w-5xl mx-auto px-6 flex items-center gap-2">
            <a
                href="/portfolio"
                class={`${navBase} ${currentPath === "" ? navActive : navInactive}`}
            >
                Home
            </a>

            <a
                href="/portfolio/certificates"
                class={`${navBase} ${currentPath === "/portfolio/certificates" ? navActive : navInactive}`}
            >
                Certificates
            </a>

            <!-- Projects Dropdown -->
            <div class="group relative">
                <!-- Dropdown Trigger Button -->
                <button
                    class={`${navBase} ${currentPath.startsWith("/portfolio/projects") ? navActive : navInactive}`}
                >
                    Projects
                    <!-- Chevron Arrow Icon -->
                    <svg
                        class="w-4 h-4 opacity-50 group-hover:opacity-100 transition-opacity"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 9l-7 7-7-7"></path>
                    </svg>
                </button>

                <!-- Dropdown Content (Hidden by default, shows on hover) -->
                <div
                    class="absolute left-0 top-full mt-0 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible translate-y-2 group-hover:translate-y-0 transition-all duration-300 ease-out z-50"
                >
                    <div
                        class="bg-white rounded-b-xl shadow-[0_10px_25px_rgba(0,0,0,0.1)] border border-slate-200 p-2 flex flex-col gap-1"
                    >
                        <a
                            href="/portfolio/projects/subscription-tracker"
                            class="px-4 py-2 text-sm font-medium text-slate-600 hover:bg-orange-100 hover:text-orange-700 rounded-lg transition-colors flex flex-col"
                        >
                            Subscription Tracker
                        </a>

                        <a
                            href="/portfolio/projects/chip8-emulator"
                            class="px-4 py-2 text-sm font-medium text-slate-600 hover:bg-orange-100 hover:text-orange-700 rounded-lg transition-colors flex flex-col"
                        >
                            CHIP8 Emulator
                        </a>

                        <a
                            href="/portfolio/projects/action-rpg-template"
                            class="px-4 py-2 text-sm font-medium text-slate-600 hover:bg-orange-100 hover:text-orange-700 rounded-lg transition-colors flex flex-col"
                        >
                            ARPG Template
                        </a>

                        <a
                            href="/portfolio/projects/skribble-clone"
                            class="px-4 py-2 text-sm font-medium text-slate-600 hover:bg-orange-100 hover:text-orange-700 rounded-lg transition-colors flex flex-col"
                        >
                            Skribble Clone
                        </a>

                        <a
                            href="/portfolio/projects/react-todo-app"
                            class="px-4 py-2 text-sm font-medium text-slate-600 hover:bg-orange-100 hover:text-orange-700 rounded-lg transition-colors flex flex-col"
                        >
                            React Todo App
                        </a>

                        <a
                            href="/portfolio/projects/tusimple-lane-detection"
                            class="px-4 py-2 text-sm font-medium text-slate-600 hover:bg-orange-100 hover:text-orange-700 rounded-lg transition-colors flex flex-col"
                        >
                            Tusimple Lane Detection
                        </a>

                        <div class="h-px w-full bg-slate-100 my-1"></div>

                        <a
                            href="https://github.com/KonyD?tab=repositories"
                            class="px-4 py-2 text-sm font-bold text-orange-500 hover:bg-orange-50 rounded-lg transition-colors flex justify-between items-center"
                        >
                            View All Projects <span>&rarr;</span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </div>
</header>
